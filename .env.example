# ====================================
# SERVER
# ====================================

PORT=3000

# ====================================
# OBJECT STORAGE (S3-compatible)
# ====================================
# Configure as many providers as you use — each one needs both an ACCESS_KEY and
# SECRET_KEY set to show up in the provider dropdown. Leave a provider's keys blank to
# omit it entirely. Which one is used when a request doesn't specify a provider:
S3_DEFAULT_PROVIDER=aws

# --- AWS S3 ---
S3_AWS_ACCESS_KEY=
S3_AWS_SECRET_KEY=
S3_AWS_REGION=ap-southeast-1
S3_AWS_ENDPOINT=
# S3_AWS_FORCE_PATH_STYLE=

# --- Wasabi ---
S3_WASABI_ACCESS_KEY=
S3_WASABI_SECRET_KEY=
S3_WASABI_REGION=ap-southeast-1
S3_WASABI_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com

# --- DigitalOcean Spaces ---
S3_DO_ACCESS_KEY=
S3_DO_SECRET_KEY=
S3_DO_REGION=sgp1
S3_DO_ENDPOINT=https://sgp1.digitaloceanspaces.com

# ====================================
# MYSQL
# ====================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Optional: reconciliation can also target a database picked per-request
# (see /reconciliation/auto/stream) instead of a single fixed schema here.
DB_DATABASE=

# ====================================
# REPORTS
# ====================================

REPORTS_DIR=reports

# ====================================
# PERFORMANCE
# ====================================
# How many buckets are scanned in parallel for /storage/summary and reconciliation. Raise
# this if you have many buckets — each bucket's own object listing is always sequential
# (S3's ListObjectsV2 pagination is inherently sequential), so this only helps when there's
# more than one bucket to scan. Safe to raise fairly high since S3 listing is network-bound,
# not CPU-bound.
STORAGE_SUMMARY_CONCURRENCY=8

# How many objects are copied in parallel when migrating files between providers (e.g. DO ->
# Wasabi via /storage/copy). Separate from STORAGE_SUMMARY_CONCURRENCY: a copy streams each
# object's full bytes through the app (not just metadata), so too high a value can saturate the
# app's own network link rather than either provider.
STORAGE_COPY_CONCURRENCY=4

# How many table/column scans run in parallel against MySQL during reconciliation. Deliberately
# separate from STORAGE_SUMMARY_CONCURRENCY (S3 calls are safe to parallelize aggressively; DB
# queries against a live production database are not) — keep this low. Raising it speeds up a
# scan but increases load on the DB server; only raise it if you know the server (ideally a read
# replica, not the primary) can take it.
DB_SCAN_CONCURRENCY=2

# Tables at or above this many rows (estimated from information_schema, not a real COUNT(*)) are
# skipped by the rich-text/JSON content scan (discover_content_columns / DO cleanup / Auto
# reconciliation's Protected check). Aimed at append-only audit/activity-log tables — usually the
# largest tables in a schema and the least valuable to scan for embedded file references. Lower
# this if those scans are still too heavy; raise it only if you're confident the DB can handle it.
MAX_CONTENT_SCAN_TABLE_ROWS=50000
